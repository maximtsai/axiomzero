# Normalize all text files to LF, in the repo and in the working tree.
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries: never convert or diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdn  binary
*.mp3  binary
*.ogg  binary
*.wav  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.zip  binary
*.exe  binary
